{% extends "layout.twig" %}

{% block title %}Подтверждение входа - {{ app_name }}{% endblock %}

{% block content %}
<div class="min-h-screen flex items-center justify-center gradient-bg py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="flex justify-center">
                {% if branding.logo_url %}
                <img src="{{ branding.logo_url }}" alt="{{ app_name }}" class="brand-logo-login">
                {% else %}
                <i class="{{ branding.logo_icon|default('fas fa-shield-alt') }} text-white text-6xl"></i>
                {% endif %}
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-white">{{ app_name }}</h2>
            <p class="mt-2 text-center text-sm text-gray-100">Подтверждение входа</p>
        </div>

        <div class="bg-white rounded-lg shadow-xl p-8">
            {% if error %}
            <div class="mb-4 bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded" role="alert">
                {{ error }}
            </div>
            {% endif %}
            {% if success %}
            <div class="mb-4 bg-green-50 border border-green-400 text-green-700 px-4 py-3 rounded" role="status">
                {{ success }}
            </div>
            {% endif %}

            <p class="text-sm text-gray-600 mb-6">
                Введите шестизначный код, отправленный на
                <strong>{{ two_factor.masked_email|default('вашу почту') }}</strong>.
                Код действует 10 минут.
            </p>

            <form class="space-y-6" method="POST" action="/login/verify">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div>
                    <label for="code" class="block text-sm font-medium text-gray-700">Код подтверждения</label>
                    <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code"
                           pattern="[0-9]{6}" maxlength="6" required autofocus
                           class="mt-1 appearance-none block w-full px-3 py-3 border border-gray-300 rounded-md shadow-sm text-center text-2xl font-semibold focus:outline-none focus:ring-purple-500 focus:border-purple-500"
                           placeholder="000000">
                </div>
                <button type="submit"
                        class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white gradient-bg hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500">
                    <i class="fas fa-check mr-2"></i>Подтвердить
                </button>
            </form>

            <div class="mt-5 flex items-center justify-between gap-4">
                <form method="POST" action="/login/verify/resend">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit"
                            {% if two_factor.resend_after|default(0) > 0 %}disabled{% endif %}
                            class="text-sm text-purple-700 hover:text-purple-900 disabled:text-gray-400 disabled:cursor-not-allowed">
                        {% if two_factor.resend_after|default(0) > 0 %}
                            Повторить через {{ two_factor.resend_after }} сек.
                        {% else %}
                            Отправить код ещё раз
                        {% endif %}
                    </button>
                </form>
                <form method="POST" action="/login/verify/cancel">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="text-sm text-gray-600 hover:text-gray-900">Вернуться ко входу</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
