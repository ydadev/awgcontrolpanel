{% extends "layout.twig" %}

{% macro sortable_header(label, key, connections, width) %}
    {% set next_direction = connections.sort == key and connections.direction == 'asc' ? 'desc' : 'asc' %}
    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase" style="width: {{ width }};">
        <a class="inline-flex items-center gap-1 hover:text-gray-900" href="/dashboard?connections_sort={{ key }}&connections_direction={{ next_direction }}&connections_per_page={{ connections.per_page }}{% if connections.search %}&connections_search={{ connections.search|url_encode }}{% endif %}">
            {{ label }}
            {% if connections.sort == key %}
            <i class="fas fa-sort-{{ connections.direction == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></i>
            {% else %}
            <i class="fas fa-sort text-gray-300" aria-hidden="true"></i>
            {% endif %}
        </a>
    </th>
{% endmacro %}

{% import _self as dashboard_ui %}

{% block title %}{{ t('dashboard.title') }} - {{ app_name }}{% endblock %}

{% block content %}
<div class="w-full max-w-none px-2 sm:px-4 lg:px-6">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            <i class="fas fa-tachometer-alt text-purple-600"></i>
            {{ t('dashboard.title') }}
        </h1>
        <p class="mt-2 text-gray-600">{{ t('dashboard.welcome') }}</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                    <i class="fas fa-server text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">{{ t('dashboard.total_servers') }}</p>
                    <p class="text-2xl font-bold text-gray-900">{{ servers|length }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-green-100 text-green-600">
                    <i class="fas fa-users text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Всего подключений</p>
                    <p class="text-2xl font-bold text-gray-900">{{ connections.total_visible|default(0) }}</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-green-100 text-green-600">
                    <i class="fas fa-wifi text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">{{ t('dashboard.online_now') }}</p>
                    <p class="text-2xl font-bold text-gray-900">
                        {{ online_count|default(0) }}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-4 sm:px-6 py-4 border-b border-gray-200 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <h2 class="text-xl font-bold text-gray-900 whitespace-nowrap">
                <i class="fas fa-plug text-green-600"></i>
                Подключения ({{ connections.total_filtered|default(0) }})
            </h2>
            <form method="GET" action="/dashboard" class="flex w-full lg:w-auto items-center gap-2">
                <input type="hidden" name="connections_per_page" value="{{ connections.per_page }}">
                <input type="hidden" name="connections_sort" value="{{ connections.sort }}">
                <input type="hidden" name="connections_direction" value="{{ connections.direction }}">
                <div class="relative flex-1 lg:w-96">
                    <i class="fas fa-search absolute left-3 top-1/2 text-gray-400" style="transform: translateY(-50%);"></i>
                    <input
                        type="search"
                        name="connections_search"
                        value="{{ connections.search|default('') }}"
                        maxlength="120"
                        placeholder="Поиск по имени или почте"
                        class="w-full border border-gray-300 rounded pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                    >
                </div>
                <button type="submit" class="gradient-bg text-white px-4 py-2 rounded text-sm whitespace-nowrap">
                    <i class="fas fa-search mr-1"></i> Найти
                </button>
                {% if connections.search %}
                <a href="/dashboard" class="text-gray-500 hover:text-gray-800 p-2" title="Сбросить поиск" aria-label="Сбросить поиск">
                    <i class="fas fa-times"></i>
                </a>
                {% endif %}
            </form>
        </div>

        {% if connections.items|length > 0 %}
        <div class="w-full overflow-x-auto">
            <table class="w-full divide-y divide-gray-200" style="min-width: 1410px; table-layout: fixed;">
                <thead class="bg-gray-50">
                    <tr>
                        {{ dashboard_ui.sortable_header('Сервер', 'server', connections, '130px') }}
                        {{ dashboard_ui.sortable_header('Подключение', 'connection', connections, '170px') }}
                        {{ dashboard_ui.sortable_header('Владелец', 'owner', connections, '230px') }}
                        {{ dashboard_ui.sortable_header('Протокол', 'protocol', connections, '145px') }}
                        {{ dashboard_ui.sortable_header('IP-адрес', 'ip', connections, '120px') }}
                        {{ dashboard_ui.sortable_header('Статус', 'status', connections, '105px') }}
                        {{ dashboard_ui.sortable_header('Срок', 'expires_at', connections, '80px') }}
                        {{ dashboard_ui.sortable_header('Трафик', 'traffic', connections, '130px') }}
                        {{ dashboard_ui.sortable_header('Лимит', 'traffic_limit', connections, '80px') }}
                        {{ dashboard_ui.sortable_header('Скорость', 'speed', connections, '125px') }}
                        {{ dashboard_ui.sortable_header('Последняя связь', 'last_handshake', connections, '135px') }}
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase" style="width: 95px;">Действия</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for client in connections.items %}
                    {% set is_online = client.last_handshake and (("now"|date('U') - client.last_handshake|date('U')) < 300) %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm font-semibold text-gray-900 truncate" title="{{ client.server_name }}">
                            <a href="/servers/{{ client.server_id }}" class="hover:text-green-700">{{ client.server_name }}</a>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-900 truncate" title="{{ client.name }}">{{ client.name }}</td>
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-gray-900 truncate" title="{{ client.owner_name|default(client.owner_email) }}">
                                {{ client.owner_name|default(client.owner_email)|default('Unknown') }}
                            </div>
                            <div class="text-xs text-gray-500 truncate" title="{{ client.owner_email|default('') }}">{{ client.owner_email|default('') }}</div>
                        </td>
                        <td class="px-4 py-3 text-sm">
                            {% if client.protocol_name %}
                            <span class="inline-block px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs truncate" style="max-width: 125px;" title="{{ client.protocol_name }}">{{ client.protocol_name }}</span>
                            {% else %}
                            <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-700 font-mono whitespace-nowrap">{{ client.client_ip }}</td>
                        <td class="px-4 py-3 text-sm whitespace-nowrap">
                            {% if is_online %}
                            <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs"><i class="fas fa-wifi mr-1"></i>Online</span>
                            {% elseif client.status == 'active' %}
                            <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">{{ t('status.active') }}</span>
                            {% else %}
                            <span class="px-2 py-1 bg-red-100 text-red-800 rounded text-xs">{{ t('status.disabled') }}</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-xs whitespace-nowrap">
                            {% if client.expires_at %}
                                {% set expires_ts = client.expires_at|date('U') %}
                                {% set diff_days = ((expires_ts - "now"|date('U')) / 86400)|round %}
                                {% if diff_days < 0 %}
                                <span class="px-2 py-1 bg-red-100 text-red-800 rounded">Истёк</span>
                                {% elseif diff_days <= 7 %}
                                <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded">{{ diff_days }} дн.</span>
                                {% else %}
                                <span class="text-gray-600">{{ client.expires_at|date('Y-m-d') }}</span>
                                {% endif %}
                            {% else %}
                            <span class="text-green-500 text-lg" title="Бессрочно">&infin;</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-xs text-gray-600 font-mono whitespace-nowrap">
                            <div>↑{{ (client.bytes_sent|default(0) / 1024 / 1024)|number_format(2) }} MB</div>
                            <div>↓{{ (client.bytes_received|default(0) / 1024 / 1024)|number_format(2) }} MB</div>
                        </td>
                        <td class="px-4 py-3 text-xs whitespace-nowrap">
                            {% if client.traffic_limit %}
                                {% set total_traffic = client.bytes_sent|default(0) + client.bytes_received|default(0) %}
                                {% set limit_gb = (client.traffic_limit / 1073741824)|number_format(2) %}
                                {% set used_gb = (total_traffic / 1073741824)|number_format(2) %}
                                {% set percentage = ((total_traffic / client.traffic_limit) * 100)|round %}
                                {% if percentage >= 100 %}
                                <span class="px-2 py-1 bg-red-100 text-red-800 rounded">Превышен</span>
                                {% elseif percentage >= 80 %}
                                <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded">{{ used_gb }} / {{ limit_gb }} GB</span>
                                {% else %}
                                <span class="text-gray-600">{{ used_gb }} / {{ limit_gb }} GB</span>
                                {% endif %}
                            {% else %}
                            <span class="text-green-500 text-lg" title="Безлимитно">&infin;</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-xs font-mono whitespace-nowrap">
                            <div class="flex flex-col items-center" style="width: 120px; max-width: 120px;">
                                <div style="height: 30px; width: 100%;">
                                    <canvas id="dashboardClientSparkline-{{ client.id }}" aria-label="График скорости за 24 часа"></canvas>
                                </div>
                                <div id="dashboard-client-speed-{{ client.id }}" class="text-[10px] mt-1 text-center leading-tight">
                                    <div class="text-green-600">↑{{ ((client.speed_up|default(0) * 8) / 1000000)|number_format(2) }} Mbit</div>
                                    <div class="text-blue-600">↓{{ ((client.speed_down|default(0) * 8) / 1000000)|number_format(2) }} Mbit</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-xs text-gray-600 whitespace-nowrap">
                            {% if client.last_handshake %}
                            <div>{{ client.last_handshake|split(' ')|first }}</div>
                            <div class="text-gray-400">{{ client.last_handshake|split(' ')|last }}</div>
                            {% else %}
                            <span class="text-gray-400">{{ t('clients.never') }}</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-right">
                            <a href="/clients/{{ client.id }}" class="text-green-600 hover:text-green-800 text-sm whitespace-nowrap">
                                <i class="fas fa-eye mr-1"></i>Открыть
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="px-4 sm:px-6 py-4 border-t border-gray-200 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-4">
                <div class="text-sm text-gray-500">Страница {{ connections.page }} из {{ connections.total_pages }}</div>
                <div class="flex items-center gap-1 text-sm" aria-label="Количество строк на странице">
                    <span class="text-gray-500 mr-1">Показывать:</span>
                    {% for per_page_value, per_page_label in {'20': '20', '50': '50', 'all': 'Все'} %}
                    <a href="/dashboard?connections_per_page={{ per_page_value }}&connections_sort={{ connections.sort }}&connections_direction={{ connections.direction }}{% if connections.search %}&connections_search={{ connections.search|url_encode }}{% endif %}" class="px-2 py-1 rounded {{ connections.per_page == per_page_value ? 'bg-green-100 text-green-800 font-semibold' : 'text-gray-600 hover:bg-gray-100' }}">{{ per_page_label }}</a>
                    {% endfor %}
                </div>
            </div>
            <div class="flex items-center gap-2">
                {% if connections.page > 1 %}
                <a href="/dashboard?connections_page={{ connections.page - 1 }}&connections_per_page={{ connections.per_page }}&connections_sort={{ connections.sort }}&connections_direction={{ connections.direction }}{% if connections.search %}&connections_search={{ connections.search|url_encode }}{% endif %}" class="border border-gray-300 px-3 py-2 rounded text-sm text-gray-700 hover:bg-gray-50">
                    <i class="fas fa-chevron-left mr-1"></i>Назад
                </a>
                {% else %}
                <span class="border border-gray-200 px-3 py-2 rounded text-sm text-gray-300 cursor-not-allowed"><i class="fas fa-chevron-left mr-1"></i>Назад</span>
                {% endif %}
                {% if connections.page < connections.total_pages %}
                <a href="/dashboard?connections_page={{ connections.page + 1 }}&connections_per_page={{ connections.per_page }}&connections_sort={{ connections.sort }}&connections_direction={{ connections.direction }}{% if connections.search %}&connections_search={{ connections.search|url_encode }}{% endif %}" class="border border-gray-300 px-3 py-2 rounded text-sm text-gray-700 hover:bg-gray-50">
                    Вперёд<i class="fas fa-chevron-right ml-1"></i>
                </a>
                {% else %}
                <span class="border border-gray-200 px-3 py-2 rounded text-sm text-gray-300 cursor-not-allowed">Вперёд<i class="fas fa-chevron-right ml-1"></i></span>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="p-12 text-center text-gray-500">
            <i class="fas fa-plug text-gray-300 text-5xl mb-4"></i>
            <p>{{ connections.search ? 'Подключения по заданному поиску не найдены' : 'Подключений пока нет' }}</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
const dashboardClientCharts = {};
let dashboardSpeedUpdateInProgress = false;

function prepareDashboardSparklineSeries(values) {
    const cleaned = values.map(value => {
        const number = Number(value);
        return Number.isFinite(number) && number > 0 ? number : 0;
    });
    const nonZero = cleaned.filter(value => value > 0).sort((a, b) => a - b);
    let capped = cleaned;
    if (nonZero.length >= 5) {
        const p95 = nonZero[Math.floor((nonZero.length - 1) * 0.95)] || 0;
        const cap = p95 > 0 ? p95 * 2 : 0;
        if (cap > 0) {
            capped = cleaned.map(value => Math.min(value, cap));
        }
    }
    return capped.map((_, index, series) => {
        const from = Math.max(0, index - 1);
        const to = Math.min(series.length - 1, index + 1);
        let sum = 0;
        for (let point = from; point <= to; point++) sum += series[point];
        return sum / (to - from + 1);
    });
}

async function updateDashboardClientSpeed(row) {
    const clientId = row.dataset.clientId;
    const canvas = document.getElementById(`dashboardClientSparkline-${clientId}`);
    try {
        const response = await fetch(`/api/clients/${clientId}/metrics?hours=24&max_points=120`, {credentials: 'same-origin'});
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        const metrics = data.success && Array.isArray(data.metrics) ? data.metrics : [];
        if (canvas) {
            const labels = metrics.map((_, index) => index);
            const upload = prepareDashboardSparklineSeries(metrics.map(metric => parseFloat(metric.speed_up_kbps) / 1000));
            const download = prepareDashboardSparklineSeries(metrics.map(metric => parseFloat(metric.speed_down_kbps) / 1000));
            if (dashboardClientCharts[clientId]) {
                dashboardClientCharts[clientId].data.labels = labels;
                dashboardClientCharts[clientId].data.datasets[0].data = upload;
                dashboardClientCharts[clientId].data.datasets[1].data = download;
                dashboardClientCharts[clientId].update('none');
            } else {
                dashboardClientCharts[clientId] = new Chart(canvas, {
                    type: 'line',
                    data: {labels, datasets: [
                        {label: 'Up', data: upload, borderColor: '#16a34a', borderWidth: 1.5, pointRadius: 0, fill: false, tension: 0.4},
                        {label: 'Down', data: download, borderColor: '#2563eb', borderWidth: 1.5, pointRadius: 0, fill: false, tension: 0.4}
                    ]},
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {legend: {display: false}, tooltip: {enabled: false}},
                        scales: {x: {display: false}, y: {display: false, beginAtZero: true}},
                        animation: false
                    }
                });
            }
        }
        if (metrics.length > 0) {
            const latest = metrics[metrics.length - 1];
            row.innerHTML = `<div class="text-green-600 whitespace-nowrap">↑${(parseFloat(latest.speed_up_kbps) / 1000).toFixed(2)} Mbit</div><div class="text-blue-600 whitespace-nowrap">↓${(parseFloat(latest.speed_down_kbps) / 1000).toFixed(2)} Mbit</div>`;
        } else {
            row.innerHTML = '<span class="text-gray-400">-</span>';
        }
    } catch (error) {
        console.error(`Failed to fetch dashboard metrics for client ${clientId}:`, error);
        row.innerHTML = '<span class="text-gray-400">-</span>';
    }
}

async function updateDashboardClientSpeeds() {
    if (dashboardSpeedUpdateInProgress) return;
    dashboardSpeedUpdateInProgress = true;
    const rows = Array.from(document.querySelectorAll('[data-dashboard-client-speed]'));
    try {
        for (let index = 0; index < rows.length; index += 6) {
            await Promise.all(rows.slice(index, index + 6).map(updateDashboardClientSpeed));
        }
    } finally {
        dashboardSpeedUpdateInProgress = false;
    }
}

document.querySelectorAll('[id^="dashboard-client-speed-"]').forEach(row => {
    row.dataset.clientId = row.id.replace('dashboard-client-speed-', '');
    row.dataset.dashboardClientSpeed = '1';
});
if (document.querySelector('[data-dashboard-client-speed]')) {
    updateDashboardClientSpeeds();
    setInterval(updateDashboardClientSpeeds, 30000);
}
</script>
{% endblock %}
