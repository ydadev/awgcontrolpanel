{% extends "layout.twig" %}
{% block title %}Динамическая маршрутизация{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-4 border-b border-gray-200 pb-5 mb-5 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Динамическая маршрутизация</h1>
      <p class="mt-1 text-sm text-gray-600">Домены и IPv4-сети по выходным туннелям</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
      {% if routing_modules %}
        <label class="block">
          <span class="mb-1 block text-xs font-medium uppercase text-gray-500">Исходный сервер</span>
          <select id="routingModuleSelect" class="min-h-10 min-w-64 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-purple-500 focus:ring-purple-500">
            {% for module in routing_modules %}
              <option value="{{ module.id }}" {% if module.is_selected %}selected{% endif %}>{{ module.server_name }}{% if module.enabled %} · включен{% else %} · выключен{% endif %}</option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
      <button type="button" id="showCreateModule" class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" title="Добавить модуль для сервера">
        <i class="fas fa-plus mr-2"></i>Модуль
      </button>
    </div>
  </div>

  {% if success_message %}
    <div class="mb-5 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-green-800"><i class="fas fa-check-circle mr-2"></i>{{ success_message }}</div>
  {% endif %}
  {% if error_message %}
    <div class="mb-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-red-800 break-words"><i class="fas fa-exclamation-circle mr-2"></i>{{ error_message }}</div>
  {% endif %}

  <form id="createModuleForm" method="POST" action="/routing/modules/create" class="hidden mb-6 border-y border-gray-200 bg-gray-50 px-4 py-4">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
      <label class="block flex-1">
        <span class="mb-1 block text-sm font-medium text-gray-800">Сервер</span>
        <select name="server_id" required class="block min-h-10 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500">
          {% for server in routing_servers %}<option value="{{ server.id }}">{{ server.name }} · {{ server.host }}</option>{% endfor %}
        </select>
      </label>
      <button type="submit" class="gradient-bg inline-flex min-h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium text-white"><i class="fas fa-plus mr-2"></i>Создать</button>
    </div>
  </form>

  <div class="mb-6 border-b border-gray-200" role="tablist" aria-label="Разделы маршрутизации">
    <div class="flex gap-6 overflow-x-auto">
      <button type="button" data-routing-tab="routes" class="routing-tab whitespace-nowrap border-b-2 px-1 py-3 text-sm font-medium"><i class="fas fa-route mr-2"></i>Правила</button>
      <button type="button" data-routing-tab="status" class="routing-tab whitespace-nowrap border-b-2 px-1 py-3 text-sm font-medium"><i class="fas fa-heartbeat mr-2"></i>Состояние</button>
    </div>
  </div>

  <section id="routes" data-routing-panel>
    <div class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div class="rounded-md border border-gray-200 bg-white px-4 py-3"><div class="text-xs uppercase text-gray-500">Модули</div><div class="mt-1 text-xl font-semibold">{{ stats.enabled_modules }}/{{ stats.modules }}</div></div>
      <div class="rounded-md border border-gray-200 bg-white px-4 py-3"><div class="text-xs uppercase text-gray-500">Направления</div><div class="mt-1 text-xl font-semibold">{{ stats.paths }}</div></div>
      <div class="rounded-md border border-gray-200 bg-white px-4 py-3"><div class="text-xs uppercase text-gray-500">Домены</div><div class="mt-1 text-xl font-semibold">{{ stats.domain_rules }}</div></div>
      <div class="rounded-md border border-gray-200 bg-white px-4 py-3"><div class="text-xs uppercase text-gray-500">IPv4/CIDR</div><div class="mt-1 text-xl font-semibold">{{ stats.cidr_rules }}</div></div>
    </div>

    {% for module in routing_modules %}
      {% if module.is_selected %}
        <div class="mb-7 border-y border-gray-200 bg-white py-5">
          <form method="POST" action="/routing/modules/{{ module.id }}/save-apply" class="module-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-lg font-semibold text-gray-900">{{ module.server_name }}</h2>
                  {% if module.enabled and module.is_synchronized %}
                    <span class="inline-flex items-center rounded bg-green-100 px-2 py-1 text-xs font-medium text-green-800"><i class="fas fa-check mr-1"></i>Работает</span>
                  {% elseif module.apply_status == 'failed' %}
                    <span class="inline-flex items-center rounded bg-red-100 px-2 py-1 text-xs font-medium text-red-800"><i class="fas fa-times mr-1"></i>Ошибка</span>
                  {% elseif module.enabled %}
                    <span class="inline-flex items-center rounded bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-800">Ожидает применения</span>
                  {% else %}
                    <span class="inline-flex items-center rounded bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">Выключен</span>
                  {% endif %}
                </div>
                <div class="mt-1 text-sm text-gray-500">{{ module.server_host }}</div>
              </div>
              <label class="inline-flex min-h-10 items-center gap-3">
                <input type="checkbox" name="enabled" value="1" {% if module.enabled %}checked{% endif %} class="h-5 w-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500">
                <span class="text-sm font-medium text-gray-800">Модуль включен</span>
              </label>
            </div>

            <div class="grid gap-4 lg:grid-cols-12">
              <label class="block lg:col-span-6">
                <span class="mb-1 block text-sm font-medium text-gray-800">DNS upstream</span>
                <input type="text" name="dns_upstreams" value="{{ module.dns_upstreams }}" required class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 font-mono text-sm focus:border-purple-500 focus:ring-purple-500">
              </label>
              <label class="block lg:col-span-2">
                <span class="mb-1 block text-sm font-medium text-gray-800">Кэш</span>
                <input type="number" name="dns_cache_size" min="0" max="100000" value="{{ module.dns_cache_size }}" required class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500">
              </label>
              <label class="block lg:col-span-2">
                <span class="mb-1 block text-sm font-medium text-gray-800">TTL набора, сек.</span>
                <input type="number" name="set_timeout_seconds" min="300" max="604800" value="{{ module.set_timeout_seconds }}" required class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500">
              </label>
              <label class="inline-flex min-h-10 items-end gap-3 pb-2 lg:col-span-2">
                <input type="checkbox" name="intercept_dns" value="1" {% if module.intercept_dns %}checked{% endif %} class="h-5 w-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500">
                <span class="text-sm font-medium text-gray-800">Перехват DNS</span>
              </label>
            </div>
            <div class="mt-5 flex justify-end">
              <button type="submit" class="gradient-bg inline-flex min-h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium text-white disabled:opacity-60"><i class="fas fa-power-off mr-2"></i><span>Сохранить и применить</span></button>
            </div>
          </form>
        </div>

        <div class="mb-4 flex items-center justify-between gap-3">
          <h2 class="text-lg font-semibold text-gray-900">Выходные направления</h2>
          <button type="button" data-show-create-path class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"><i class="fas fa-plus mr-2"></i>Направление</button>
        </div>

        <form data-create-path method="POST" action="/routing/modules/{{ module.id }}/paths/create" class="hidden mb-6 border-y border-gray-200 bg-gray-50 px-4 py-4">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            <label class="block"><span class="mb-1 block text-sm font-medium text-gray-800">Название</span><input type="text" name="name" required placeholder="kazan1 → vienna1" class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500"></label>
            <label class="block">
              <span class="mb-1 block text-sm font-medium text-gray-800">Сервер выхода</span>
              <select name="egress_server_id" class="block min-h-10 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500">
                <option value="">Внешний/ручной туннель</option>
                {% for server in routing_servers %}{% if server.id != module.server_id %}<option value="{{ server.id }}">{{ server.name }}</option>{% endif %}{% endfor %}
              </select>
            </label>
            <label class="block"><span class="mb-1 block text-sm font-medium text-gray-800">Интерфейс</span><input type="text" name="interface_name" required placeholder="awg-egress" class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 font-mono text-sm focus:border-purple-500 focus:ring-purple-500"></label>
            <label class="block"><span class="mb-1 block text-sm font-medium text-gray-800">Приоритет</span><input type="number" name="priority" min="1" max="10000" value="100" required class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500"></label>
            <label class="block md:col-span-2"><span class="mb-1 block text-sm font-medium text-gray-800">Конфигурация peer</span><input type="text" name="peer_config_path" placeholder="/opt/amnezia/example/example.conf" class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 font-mono text-sm focus:border-purple-500 focus:ring-purple-500"></label>
            <label class="block"><span class="mb-1 block text-sm font-medium text-gray-800">Транспорт</span><input type="text" name="transport_label" value="AmneziaWG 2.0" class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500"></label>
            <label class="block"><span class="mb-1 block text-sm font-medium text-gray-800">TCP MSS</span><input type="number" name="tcp_mss" min="536" max="8960" placeholder="авто" class="block min-h-10 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500"></label>
          </div>
          <div class="mt-4 flex justify-end"><button type="submit" class="gradient-bg inline-flex min-h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium text-white"><i class="fas fa-plus mr-2"></i>Создать направление</button></div>
        </form>

        <div class="space-y-5">
          {% for path in module.paths %}
            <article class="rounded-md border border-gray-200 bg-white shadow-sm">
              <form method="POST" action="/routing/paths/{{ path.id }}/save-apply" class="path-form">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="module_id" value="{{ module.id }}">
                <input type="hidden" name="expected_hash" value="{{ path.edit_hash }}">
                <div class="flex flex-col gap-3 border-b border-gray-200 px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-2"><h3 class="text-base font-semibold text-gray-900">{{ path.name }}</h3><span class="inline-flex rounded bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">{{ path.transport_label }}</span></div>
                    <div class="mt-1 font-mono text-xs text-gray-500">{{ path.interface_name }} · table {{ path.routing_table_id }} · mark {{ path.fwmark }}</div>
                  </div>
                  <div class="flex flex-wrap items-end gap-4">
                    <label class="block w-28"><span class="mb-1 block text-xs font-medium text-gray-500">Приоритет</span><input type="number" name="priority" min="1" max="10000" value="{{ path.priority }}" required class="block min-h-9 w-full rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-purple-500 focus:ring-purple-500"></label>
                    <label class="block w-28"><span class="mb-1 block text-xs font-medium text-gray-500">TCP MSS</span><input type="number" name="tcp_mss" min="536" max="8960" value="{{ path.tcp_mss }}" placeholder="авто" class="block min-h-9 w-full rounded-md border border-gray-300 px-2 py-1 text-sm focus:border-purple-500 focus:ring-purple-500"></label>
                    <label class="inline-flex min-h-9 items-center gap-2"><input type="checkbox" name="enabled" value="1" {% if path.enabled %}checked{% endif %} class="h-5 w-5 rounded border-gray-300 text-purple-600 focus:ring-purple-500"><span class="text-sm font-medium text-gray-700">Включено</span></label>
                  </div>
                </div>

                <div class="grid gap-0 lg:grid-cols-2 lg:divide-x lg:divide-gray-200">
                  <label class="block px-5 py-5"><span class="mb-2 block text-sm font-medium text-gray-800">Домены</span><textarea name="domains" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="*.youtube.com&#10;api.youtube.com&#10;*.com" class="block w-full resize-y rounded-md border border-gray-300 bg-gray-50 px-3 py-3 font-mono text-sm leading-6 text-gray-900 focus:border-purple-500 focus:ring-purple-500">{{ path.domains_text }}</textarea></label>
                  <label class="block px-5 py-5"><span class="mb-2 block text-sm font-medium text-gray-800">IPv4 и подсети</span><textarea name="cidrs" rows="12" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="192.0.2.0/24&#10;203.0.113.10/32" class="block w-full resize-y rounded-md border border-gray-300 bg-gray-50 px-3 py-3 font-mono text-sm leading-6 text-gray-900 focus:border-purple-500 focus:ring-purple-500">{{ path.cidrs_text }}</textarea></label>
                </div>
                <div class="flex justify-end border-t border-gray-200 px-5 py-4"><button type="submit" class="gradient-bg inline-flex min-h-10 items-center justify-center rounded-md px-4 py-2 text-sm font-medium text-white disabled:opacity-60"><i class="fas fa-cloud-upload-alt mr-2"></i><span>Сохранить и применить</span></button></div>
              </form>
            </article>
          {% else %}
            <div class="rounded-md border border-yellow-200 bg-yellow-50 px-4 py-5 text-yellow-900">Направления еще не созданы.</div>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="rounded-md border border-yellow-200 bg-yellow-50 px-4 py-5 text-yellow-900">Создайте модуль для исходного VPN-сервера.</div>
    {% endfor %}
  </section>

  <section id="status" data-routing-panel class="hidden">
    <div class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4"><h2 class="text-lg font-semibold text-gray-900">Состояние модулей</h2></div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50"><tr><th class="px-5 py-3 text-left text-xs font-medium uppercase text-gray-500">Сервер</th><th class="px-5 py-3 text-left text-xs font-medium uppercase text-gray-500">Состояние</th><th class="px-5 py-3 text-left text-xs font-medium uppercase text-gray-500">Направления</th><th class="px-5 py-3 text-left text-xs font-medium uppercase text-gray-500">Применено</th><th class="px-5 py-3 text-right text-xs font-medium uppercase text-gray-500">Действие</th></tr></thead>
          <tbody class="divide-y divide-gray-200">
            {% for module in routing_modules %}
              <tr>
                <td class="px-5 py-3"><div class="font-medium text-gray-900">{{ module.server_name }}</div><div class="mt-1 font-mono text-xs text-gray-500">{{ module.server_host }}</div></td>
                <td class="px-5 py-3 text-sm">
                  {% if module.enabled and module.is_synchronized %}<span class="text-green-700"><i class="fas fa-check-circle mr-1"></i>Работает</span>{% elseif module.apply_status == 'failed' %}<span class="text-red-700"><i class="fas fa-exclamation-circle mr-1"></i>Ошибка</span>{% elseif module.enabled %}<span class="text-yellow-700">{{ module.apply_status }}</span>{% else %}<span class="text-gray-600">Выключен</span>{% endif %}
                  {% if module.last_error %}<div class="mt-1 max-w-xl text-xs text-red-700 break-words">{{ module.last_error }}</div>{% endif %}
                </td>
                <td class="px-5 py-3 text-sm text-gray-700">{{ module.paths|length }}</td>
                <td class="px-5 py-3 text-sm text-gray-700">{{ module.last_applied_at|default('—') }}</td>
                <td class="px-5 py-3 text-right"><form method="POST" action="/routing/modules/{{ module.id }}/apply"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit" class="inline-flex min-h-9 items-center rounded-md border border-gray-300 bg-white px-3 py-1 text-sm font-medium text-gray-700 hover:bg-gray-50" title="Применить повторно"><i class="fas fa-sync-alt mr-2"></i>Применить</button></form></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const tabs = Array.from(document.querySelectorAll('[data-routing-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-routing-panel]'));
  const validTabs = tabs.map(function (tab) { return tab.dataset.routingTab; });
  function activate(name, updateHash) {
    const selected = validTabs.includes(name) ? name : 'routes';
    tabs.forEach(function (tab) {
      const active = tab.dataset.routingTab === selected;
      tab.classList.toggle('border-purple-600', active);
      tab.classList.toggle('text-purple-700', active);
      tab.classList.toggle('border-transparent', !active);
      tab.classList.toggle('text-gray-500', !active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    panels.forEach(function (panel) { panel.classList.toggle('hidden', panel.id !== selected); });
    if (updateHash) history.replaceState(null, '', '#' + selected);
  }
  tabs.forEach(function (tab) { tab.addEventListener('click', function () { activate(tab.dataset.routingTab, true); }); });
  const moduleSelect = document.getElementById('routingModuleSelect');
  if (moduleSelect) moduleSelect.addEventListener('change', function () { window.location.href = '/routing?module_id=' + encodeURIComponent(moduleSelect.value) + '#routes'; });
  const createModuleButton = document.getElementById('showCreateModule');
  const createModuleForm = document.getElementById('createModuleForm');
  if (createModuleButton && createModuleForm) createModuleButton.addEventListener('click', function () { createModuleForm.classList.toggle('hidden'); });
  document.querySelectorAll('[data-show-create-path]').forEach(function (button) { button.addEventListener('click', function () { const form = document.querySelector('[data-create-path]'); if (form) form.classList.toggle('hidden'); }); });
  document.querySelectorAll('.module-form, .path-form').forEach(function (form) {
    form.addEventListener('submit', function () {
      const button = form.querySelector('button[type="submit"]');
      if (!button) return;
      button.disabled = true;
      const label = button.querySelector('span');
      if (label) label.textContent = 'Применение...';
    });
  });
  activate(window.location.hash.slice(1), false);
});
</script>
{% endblock %}
