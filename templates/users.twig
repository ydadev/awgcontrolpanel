{% extends "layout.twig" %}

{% block title %}Пользователи - {{ app_name }}{% endblock %}

{% block styles %}
<style>
.users-table {
    min-width: 1500px;
}
.users-table th,
.users-table td {
    padding-left: 1rem;
    padding-right: 1rem;
}
</style>
{% endblock %}

{% block content %}
<div class="w-full mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Пользователи</h1>
    </div>

    {% if success %}
    <div class="mb-4 bg-green-50 border-l-4 border-green-400 p-4">
        <div class="flex">
            <i class="fas fa-check-circle text-green-400 mt-0.5"></i>
            <p class="ml-3 text-sm text-green-700">{{ success }}</p>
        </div>
    </div>
    {% endif %}

    {% if error %}
    <div class="mb-4 bg-red-50 border-l-4 border-red-400 p-4">
        <div class="flex">
            <i class="fas fa-exclamation-circle text-red-400 mt-0.5"></i>
            <p class="ml-3 text-sm text-red-700">{{ error }}</p>
        </div>
    </div>
    {% endif %}

    <div class="bg-white shadow rounded-lg mb-6">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">
                <i class="fas fa-user-plus mr-2 text-purple-600"></i>{{ t('users.add_user') }}
            </h2>
        </div>
        <div class="px-6 py-5">
            <form method="POST" action="/users/add">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ t('auth.name') }}</label>
                        <input type="text" name="name" required class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ t('auth.email') }}</label>
                        <input type="email" name="email" required class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ t('auth.password') }}</label>
                        <input id="add-user-password" type="password" name="password" minlength="6" disabled
                               placeholder="Будет создан автоматически"
                               class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500 disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ t('users.role') }}</label>
                        <select id="add-user-role" name="role" class="block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                            <option value="user">{{ t('users.role_user') }}</option>
                            <option value="admin">{{ t('users.role_admin') }}</option>
                        </select>
                    </div>
                    <div class="flex items-center">
                        <label class="inline-flex items-center">
                            <input id="add-user-site-access" type="checkbox" name="site_access" value="1" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500 disabled:cursor-not-allowed">
                            <span class="ml-2 text-sm text-gray-700">Доступ к сайту</span>
                        </label>
                    </div>
                </div>
                <button type="submit" class="mt-4 px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700">
                    <i class="fas fa-user-plus mr-2"></i>{{ t('users.add_user') }}
                </button>
            </form>
        </div>
    </div>

    <div id="users-list-panel" class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-200 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <h2 class="text-lg font-medium text-gray-900">
                <i class="fas fa-users mr-2 text-purple-600"></i>{{ t('users.all_users') }}
            </h2>
            <div class="w-full lg:w-96">
                <label for="user-search" class="sr-only">Поиск пользователей</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                        <i class="fas fa-search"></i>
                    </span>
                    <input id="user-search" type="search" autocomplete="off" placeholder="Поиск по имени или почте"
                           class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
                </div>
                <p id="user-search-count" class="mt-1 text-xs text-gray-500 text-right">Показано: {{ users|length }}</p>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="users-table w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('auth.name') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('auth.email') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('users.role') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Доступ к сайту</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Доступ к серверам</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('users.created') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ t('settings.actions') }}</th>
                    </tr>
                </thead>
                <tbody id="users-table-body" class="bg-white divide-y divide-gray-200">
                    {% for u in users %}
                    <tr data-user-row>
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                <i class="fas fa-user-circle text-gray-400 text-lg mr-2"></i>
                                <span data-user-name class="text-sm font-medium">{{ u.name }}</span>
                            </div>
                        </td>
                        <td data-user-email class="px-6 py-4 text-sm text-gray-500">{{ u.email }}</td>
                        <td class="px-6 py-4">
                            {% if u.role == 'admin' %}
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">{{ t('users.role_admin') }}</span>
                            {% else %}
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">{{ t('users.role_user') }}</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm">
                            {% if u.role == 'admin' %}
                            <label class="inline-flex items-center text-gray-500" title="Администраторы всегда имеют доступ">
                                <input type="checkbox" checked disabled class="rounded border-gray-300 text-purple-600">
                                <span class="ml-2">Включен</span>
                            </label>
                            {% else %}
                            <form method="POST" action="/users/{{ u.id }}/site-access" class="inline-flex">
                                <input type="hidden" name="site_access" value="0">
                                <label class="inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="site_access" value="1"
                                           class="rounded border-gray-300 text-purple-600 focus:ring-purple-500"
                                           {% if u.status == 'active' %}checked{% endif %}
                                           onchange="this.form.submit()">
                                    <span class="ml-2 {% if u.status == 'active' %}text-green-700{% else %}text-gray-500{% endif %}">
                                        {{ u.status == 'active' ? 'Включен' : 'Выключен' }}
                                    </span>
                                </label>
                            </form>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm min-w-72">
                            {% if u.role == 'admin' %}
                            <span class="text-gray-500">Полный доступ по роли</span>
                            {% elseif all_servers|length > 0 %}
                            <form method="POST" action="/users/{{ u.id }}/server-access" class="space-y-3">
                                <div class="space-y-2">
                                    {% for server in all_servers %}
                                    {% set access = user_server_access[u.id][server.id]|default(null) %}
                                    <div class="border rounded p-2">
                                        <div class="font-medium text-gray-900">{{ server.name }}</div>
                                        <div class="text-xs text-gray-500 mb-2">{{ server.host }}</div>
                                        <label class="inline-flex items-center mr-4">
                                            <input type="checkbox" name="server_ids[]" value="{{ server.id }}" class="rounded border-gray-300 text-purple-600" {% if access %}checked{% endif %}>
                                            <span class="ml-2">Доступ</span>
                                        </label>
                                        <label class="inline-flex items-center">
                                            <input type="checkbox" name="create_client_server_ids[]" value="{{ server.id }}" class="rounded border-gray-300 text-purple-600" {% if access and access.can_create_clients %}checked{% endif %}>
                                            <span class="ml-2">Создание конфигов</span>
                                        </label>
                                    </div>
                                    {% endfor %}
                                </div>
                                <p class="text-xs text-amber-700">Снятие доступа блокирует активные конфиги пользователя на сервере.</p>
                                <button type="submit" class="px-3 py-1 bg-purple-600 text-white rounded text-xs hover:bg-purple-700">
                                    <i class="fas fa-save mr-1"></i>{{ t('form.save') }}
                                </button>
                            </form>
                            {% else %}
                            <span class="text-gray-500">Серверы еще не добавлены</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500 whitespace-nowrap">{{ u.created_at|date('Y-m-d') }}</td>
                        <td class="px-6 py-4 text-sm min-w-52">
                            {% if u.id != user.id %}
                            <form method="POST" action="/users/{{ u.id }}/password" class="mb-3 space-y-2">
                                <label class="block text-xs font-medium text-gray-700">Задать пароль</label>
                                <input type="password" name="new_password" required minlength="6" placeholder="Новый пароль"
                                       class="block w-48 px-2 py-1 border border-gray-300 rounded text-xs focus:ring-purple-500 focus:border-purple-500">
                                <input type="password" name="confirm_password" required minlength="6" placeholder="Повторите пароль"
                                       class="block w-48 px-2 py-1 border border-gray-300 rounded text-xs focus:ring-purple-500 focus:border-purple-500">
                                <button type="submit" class="text-purple-600 hover:text-purple-900 text-xs">
                                    <i class="fas fa-key mr-1"></i>Обновить пароль
                                </button>
                            </form>
                            <form method="POST" action="/users/{{ u.id }}/delete" class="inline" onsubmit="return confirm('{{ t('users.delete_confirm', [u.name]) }}')">
                                <button type="submit" class="text-red-600 hover:text-red-900">
                                    <i class="fas fa-trash"></i> {{ t('clients.delete') }}
                                </button>
                            </form>
                            {% else %}
                            <a href="/settings#profile" class="text-purple-600 hover:text-purple-900">
                                <i class="fas fa-key mr-1"></i>{{ t('settings.change_password') }}
                            </a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    <tr id="user-search-empty" class="hidden">
                        <td colspan="7" class="px-6 py-10 text-center text-sm text-gray-500">
                            Пользователи не найдены
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const addUserRole = document.getElementById('add-user-role');
    const addUserSiteAccess = document.getElementById('add-user-site-access');
    const addUserPassword = document.getElementById('add-user-password');
    const searchInput = document.getElementById('user-search');
    const rows = Array.from(document.querySelectorAll('[data-user-row]'));
    const emptyRow = document.getElementById('user-search-empty');
    const count = document.getElementById('user-search-count');

    let regularUserSiteAccess = addUserSiteAccess.checked;

    function syncNewUserPassword() {
        const isAdmin = addUserRole.value === 'admin';
        if (isAdmin) {
            addUserSiteAccess.checked = true;
            addUserSiteAccess.disabled = true;
        } else {
            addUserSiteAccess.disabled = false;
            addUserSiteAccess.checked = regularUserSiteAccess;
        }

        const passwordIsRequired = isAdmin || addUserSiteAccess.checked;
        addUserPassword.disabled = !passwordIsRequired;
        addUserPassword.required = passwordIsRequired;
        addUserPassword.placeholder = passwordIsRequired
            ? 'Введите пароль'
            : 'Будет создан автоматически';
        if (!passwordIsRequired) {
            addUserPassword.value = '';
        }
    }

    addUserSiteAccess.addEventListener('change', function () {
        regularUserSiteAccess = addUserSiteAccess.checked;
        syncNewUserPassword();
    });
    addUserRole.addEventListener('change', syncNewUserPassword);
    syncNewUserPassword();

    searchInput.addEventListener('input', function () {
        const query = searchInput.value.trim().toLocaleLowerCase('ru-RU');
        let visible = 0;

        rows.forEach(function (row) {
            const name = row.querySelector('[data-user-name]').textContent;
            const email = row.querySelector('[data-user-email]').textContent;
            const matches = (name + ' ' + email).toLocaleLowerCase('ru-RU').includes(query);
            row.classList.toggle('hidden', !matches);
            if (matches) {
                visible++;
            }
        });

        emptyRow.classList.toggle('hidden', visible !== 0);
        count.textContent = 'Показано: ' + visible;
    });
});
</script>
{% endblock %}
